#!/bin/sh /etc/rc.common

START=79
STOP=12
USE_PROCD=1

DNSMASQ_BIN=${ETHYL_CAPTIVE_DNS_BIN:-/usr/sbin/dnsmasq}
LISTEN_IP=${ETHYL_CAPTIVE_DNS_IP:-10.0.0.1}
LISTEN_PORT=${ETHYL_CAPTIVE_DNS_PORT:-1053}

start_service() {
    procd_open_instance
    procd_set_param command \
        "$DNSMASQ_BIN" \
        --keep-in-foreground \
        --conf-file=/dev/null \
        --port="$LISTEN_PORT" \
        --listen-address="$LISTEN_IP" \
        --bind-interfaces \
        --no-resolv \
        --no-hosts \
        --address=/#/10.0.0.1 \
        --pid-file=/var/run/ethyl-captive-dns.pid
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
